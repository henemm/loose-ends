    "Couldn't create the Loose Ends calendar in any of your accounts." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Kalender „Loose Ends“ ließ sich in keinem deiner Konten anlegen." } } } },
    "The calendar couldn't be updated." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Kalender ließ sich nicht aktualisieren." } } } },
    "Recognize speech via Apple?" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Spracherkennung über Apple?" } } } },
    "Speech recognition on this device did not start. Loose Ends can let Apple recognize it instead — your recording leaves the device in that case. Typing always works." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Spracherkennung auf diesem Gerät ist nicht gestartet. Loose Ends kann sie stattdessen von Apple erledigen lassen — deine Aufnahme verlässt dann das Gerät. Tippen geht immer." } } } },
    "Speech recognition on this device did not start." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Spracherkennung auf diesem Gerät ist nicht gestartet." } } } },
    "Speech recognition is not available. You can type instead." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Spracherkennung ist nicht verfügbar. Du kannst stattdessen tippen." } } } },
    "Speech recognition on this device is not available. You can type instead." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Spracherkennung auf diesem Gerät ist nicht verfügbar. Du kannst stattdessen tippen." } } } },
    "Allow" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Erlauben" } } } },
    "Not now" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Jetzt nicht" } } } },
    "From a day count in the note." : { "extractionState" : "translated", "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aus einer Tagesangabe in der Notiz." } } } },
    "From the weekday named in the note." : { "extractionState" : "translated", "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aus dem Wochentag in der Notiz." } } } },
    "From a weekday of next week in the note." : { "extractionState" : "translated", "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aus einem Wochentag der nächsten Woche in der Notiz." } } } },
    "From “next” plus a weekday in the note: the following week." : { "extractionState" : "translated", "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aus „nächsten“ plus Wochentag in der Notiz: die Folgewoche." } } } },
    "From “end of the month” in the note." : { "extractionState" : "translated", "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aus „Ende des Monats“ in der Notiz." } } } },
    "From the day of the month in the note." : { "extractionState" : "translated", "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aus dem Tag des Monats in der Notiz." } } } },
    "From “weekend” in the note: Saturday." : { "extractionState" : "translated", "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aus „Wochenende“ in der Notiz: Samstag." } } } },
    "From “next month” in the note: the first of that month." : { "extractionState" : "translated", "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aus „nächsten Monat“ in der Notiz: der Erste des Monats." } } } },
    "From the day and month in the note." : { "extractionState" : "translated", "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aus Tag und Monat in der Notiz." } } } },
    "From an amount of money in the note." : { "extractionState" : "translated", "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aus einem Geldbetrag in der Notiz." } } } },
    "From official or legal language in the note." : { "extractionState" : "translated", "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aus amtlicher oder rechtlicher Sprache in der Notiz." } } } },
    "From someone waiting for this in the note." : { "extractionState" : "translated", "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Weil jemand in der Notiz darauf wartet." } } } },
    "From Siri." : { "extractionState" : "translated", "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Von Siri." } } } },
    "From the word “important” in the note." : { "extractionState" : "translated", "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aus dem Wort „wichtig“ in der Notiz." } } } },
    "From an urgency word in the note." : { "extractionState" : "translated", "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aus einem Dringlichkeits-Wort in der Notiz." } } } },
    "From a deadline reference in the note." : { "extractionState" : "translated", "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aus einem Fristbezug in der Notiz." } } } },
    "From a raw text captured before, word for word." : { "extractionState" : "translated", "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Aus einem schon einmal erfassten Text, wortgleich." } } } },
    "Date…" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Datum …" } } } },
    "Move to" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Verschieben auf" } } } },
    "Undo" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Rückgängig" } } } },
    "Analyze again" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Neu analysieren" } } } },
    "Analyzing again…" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Wird neu analysiert …" } } } },
    "Still sorting other tasks. Try again in a moment." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Andere Aufgaben werden noch sortiert. Gleich noch einmal versuchen." } } } },
    "Could not analyze again." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Neu analysieren ging nicht." } } } },
    "Nothing new found." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Nichts Neues gefunden." } } } },
    "One field updated." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Ein Feld aktualisiert." } } } },
    "%lld fields updated." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "%lld Felder aktualisiert." } } } },
    "Apple Intelligence did not run, only the rules." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence lief nicht, nur die Regeln." } } } },
    "Skip" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Überspringen" } } } },
    "Start" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Los geht’s" } } } },
    "Continue" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Weiter" } } } },
    "Allow notifications" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Mitteilungen erlauben" } } } },
    "Capture without opening the app" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Erfassen, ohne die App zu öffnen" } } } },
    "Say “Add to Loose Ends” to Siri. Control Center and the Action Button open the capture right away." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Sag zu Siri „Add to Loose Ends“. Kontrollzentrum und Aktionstaste öffnen die Erfassung sofort." } } } },
    "One reminder on the day" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Eine Erinnerung am Tag selbst" } } } },
    "At nine in the morning, what is due today. Complete, Next up or Tomorrow straight from the notification." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Um neun Uhr morgens, was heute fällig ist. Erledigt, Als nächstes oder Morgen direkt aus der Mitteilung." } } } },
    "Where things get done" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Wo Dinge erledigt werden" } } } },
    "These contexts come with the app. Rename, delete or add your own on the start screen." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Kontexte bringt die App mit. Auf dem Startbildschirm kannst du sie umbenennen, löschen oder eigene hinzufügen." } } } },
    "Apple Intelligence is off. Turn it on in Settings so new tasks get a title and a duration." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence ist aus. Schalte es in den Einstellungen ein, damit neue Aufgaben Titel und Dauer bekommen." } } } },
    "Apple Intelligence is still getting ready. Tasks captured meanwhile are sorted once it is." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Apple Intelligence wird noch vorbereitet. Was du bis dahin erfasst, wird danach sortiert." } } } },
    "This device has no Apple Intelligence. Tasks keep the words you said; due dates, importance and urgency are still found." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieses Gerät hat kein Apple Intelligence. Aufgaben behalten deine Worte; Fälligkeit, Wichtigkeit und Dringlichkeit werden trotzdem erkannt." } } } },
    "Show subtasks" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Unteraufgaben zeigen" } } } },
    "Hide subtasks" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Unteraufgaben ausblenden" } } } },
    "Shown" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Angezeigt" } } } },
    "Hidden" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Ausgeblendet" } } } }
  }
}
