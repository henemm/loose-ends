    "Attach a bead (%lld of %lld)" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Perle anhängen (%1$lld von %2$lld)" } } } },
    "Make “%@” the Knäuel?" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "„%@“ zum Knäuel machen?" } } } },
    "“%@” is the Knäuel so far. Only one task can be." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Bisher ist „%@“ das Knäuel. Nur eine Aufgabe kann es sein." } } } },
    "Move the Knäuel" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Knäuel wandern lassen" } } } },
