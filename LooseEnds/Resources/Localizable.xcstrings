    "Hidden" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Ausgeblendet" } } } },
    "No text yet — model: %@ · microphone: %@ · buffers: %lld · results: %lld" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Noch kein Text — Modell: %@ · Mikrofon: %@ · Puffer: %lld · Ergebnisse: %lld" } } } },
