    "No location found" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Kein Standort gefunden" } } } },
    "Location is off in Settings. The place is saved but won't remind you." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Standort ist in den Einstellungen aus. Der Ort ist gespeichert, erinnert aber nicht." } } } },
    "You're already here. Reminds you the next time you arrive." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Du bist schon hier. Erinnert beim nächsten Ankommen." } } } },
