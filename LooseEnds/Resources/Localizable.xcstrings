    "Reminds you when you arrive or leave." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Erinnert beim Ankommen oder Verlassen." } } } },
    "The rules read it from your words even when off." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Regel liest sie aus den Wörtern, auch wenn aus." } } } },
    "Also the group on the start page." : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Auch die Gruppe auf der Startseite." } } } },
