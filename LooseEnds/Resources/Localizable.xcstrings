    "Active · %@, just now" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Active · %@, just now" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktiv · %@, gerade eben" } } } },
    "Active · %@, %lld min ago" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Active · %1$@, %2$lld min ago" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktiv · %1$@, vor %2$lld Min." } } } },
    "Your tasks are kept in sync with your other devices." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your tasks are kept in sync with your other devices." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Deine Aufgaben werden mit deinen anderen Geräten abgeglichen." } } } },
    "This device only sees its own tasks. Restart the app. If that doesn’t help, sign in to iCloud." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This device only sees its own tasks. Restart the app. If that doesn’t help, sign in to iCloud." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieses Gerät sieht nur seine eigenen Aufgaben. Starte die App neu. Hilft das nicht, melde dich bei iCloud an." } } } },
    "Unknown error" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unknown error" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Unbekannter Fehler" } } } },
