    "Speech diagnosis start: %@ s (opening %@ · model %@ · rights %@ · analyzer %@ · microphone %@)" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start: %@ s (opening %@ · model %@ · rights %@ · analyzer %@ · microphone %@)" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Start: %@ s (Öffnen %@ · Modell %@ · Rechte %@ · Analyzer %@ · Mikrofon %@)" } } } },
    "Speech diagnosis first text after %@ s" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "First text after %@ s" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erster Text nach %@ s" } } } },
    "Speech diagnosis short" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sound arrives, but no text recognized" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Ton kommt an, aber kein Text erkannt" } } } },
    "Speech diagnosis join" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : " · " } }, "de" : { "stringUnit" : { "state" : "translated", "value" : " · " } } } },
    "iCloud" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "iCloud" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "iCloud" } } } },
    "iCloud sync" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "iCloud sync" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "iCloud-Abgleich" } } } },
    "Waiting for iCloud" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for iCloud" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Wartet auf iCloud" } } } },
    "Disturbed" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disturbed" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Gestört" } } } },
    "This device only" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This device only" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Nur auf diesem Gerät" } } } },
    "Set up" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Set up" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Eingerichtet" } } } },
