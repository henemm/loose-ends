<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(LE_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Loose Ends</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSpokenName</key>
	<string>Loose Ends</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.henning.looseends</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>looseends</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>LE_ALT_NAME_1</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>LE_ALT_HINT_1</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>LE_ALT_NAME_2</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>LE_ALT_HINT_2</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>LE_ALT_NAME_3</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>LE_ALT_HINT_3</string>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LEAppGroup</key>
	<string>group.com.henning.looseends$(BUNDLE_ID_SUFFIX)</string>
	<key>LECloudContainer</key>
	<string>iCloud.com.henning.looseends$(BUNDLE_ID_SUFFIX)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Only if you switch it on, a task with a due date is shown in "Loose Ends" or in a calendar you pick. The app only changes its own events.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Only when a task has a place, Loose Ends asks the system to remind you when you arrive or leave.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Loose Ends listens so you can say a task instead of typing it.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Speech is turned into text on your device to capture a task.</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.henning.looseends.capture</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
