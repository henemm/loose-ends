DEFINE SCHEMA

    RECORD TYPE CDMR (
        CD_entityNames   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_recordNames   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_relationships STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_TaskAttachment (
        CD_createdAt              TIMESTAMP QUERYABLE SORTABLE,
        CD_data                   BYTES QUERYABLE SORTABLE,
        CD_data_ckAsset           ASSET,
        CD_entityName             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fileName               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fileName_ckAsset       ASSET,
        CD_id                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt            BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset    ASSET,
        CD_task                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_typeIdentifier         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_typeIdentifier_ckAsset ASSET,
        "___createTime"           TIMESTAMP,
        "___createdBy"            REFERENCE,
        "___etag"                 STRING,
        "___modTime"              TIMESTAMP,
        "___modifiedBy"           REFERENCE,
        "___recordID"             REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_CompletionRecord (
        CD_completedAt         TIMESTAMP QUERYABLE SORTABLE,
        CD_dueDateAtCompletion TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_task                STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Project (
        CD_archivedAt          TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_name                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset        ASSET,
        CD_ownerID             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ownerID_ckAsset     ASSET,
        CD_sortOrder           INT64 QUERYABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Revision (
        CD_authorRaw           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_authorRaw_ckAsset   ASSET,
        CD_createdAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fieldRaw            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fieldRaw_ckAsset    ASSET,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_newValue            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_newValue_ckAsset    ASSET,
        CD_oldValue            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_oldValue_ckAsset    ASSET,
        CD_reason              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_reason_ckAsset      ASSET,
        CD_seenAt              TIMESTAMP QUERYABLE SORTABLE,
        CD_task                STRING QUERYABLE SEARCHABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_SavedView (
        CD_contextID           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isHidden            INT64 QUERYABLE SORTABLE,
        CD_isSystem            INT64 QUERYABLE SORTABLE,
        CD_kindRaw             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_kindRaw_ckAsset     ASSET,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_name                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset        ASSET,
        CD_projectID           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sortOrder           INT64 QUERYABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_TaskContext (
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_forgottenWordsRaw   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_forgottenWordsRaw_ckAsset ASSET,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isSystemDefault     INT64 QUERYABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_name                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset        ASSET,
        CD_sortOrder           INT64 QUERYABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_TaskItem (
        CD_calendarAccount             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_calendarAccount_ckAsset     ASSET,
        CD_calendarEventID             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_calendarEventID_ckAsset     ASSET,
        CD_calendarName                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_calendarName_ckAsset        ASSET,
        CD_capturedAt                  TIMESTAMP QUERYABLE SORTABLE,
        CD_capturedViaRaw              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_capturedViaRaw_ckAsset      ASSET,
        CD_completedAt                 TIMESTAMP QUERYABLE SORTABLE,
        CD_contextsConfidence          DOUBLE QUERYABLE SORTABLE,
        CD_contextsSourceRaw           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_contextsSourceRaw_ckAsset   ASSET,
        CD_countsAt                    TIMESTAMP QUERYABLE SORTABLE,
        CD_dueConfidence               DOUBLE QUERYABLE SORTABLE,
        CD_dueDate                     TIMESTAMP QUERYABLE SORTABLE,
        CD_dueHasTime                  INT64 QUERYABLE SORTABLE,
        CD_dueSourceRaw                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_dueSourceRaw_ckAsset        ASSET,
        CD_durationConfidence          DOUBLE QUERYABLE SORTABLE,
        CD_durationRaw                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_durationRaw_ckAsset         ASSET,
        CD_durationSourceRaw           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_durationSourceRaw_ckAsset   ASSET,
        CD_energyConfidence            DOUBLE QUERYABLE SORTABLE,
        CD_energyRaw                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_energyRaw_ckAsset           ASSET,
        CD_energySourceRaw             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_energySourceRaw_ckAsset     ASSET,
        CD_entityName                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_importanceConfidence        DOUBLE QUERYABLE SORTABLE,
        CD_importanceRaw               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_importanceRaw_ckAsset       ASSET,
        CD_importanceSourceRaw         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_importanceSourceRaw_ckAsset ASSET,
        CD_knaeuelAt                   TIMESTAMP QUERYABLE SORTABLE,
        CD_moveReceipt                 BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset         ASSET,
        CD_nextRank                    DOUBLE QUERYABLE SORTABLE,
        CD_notes                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notesSourceRaw              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notesSourceRaw_ckAsset      ASSET,
        CD_notes_ckAsset               ASSET,
        CD_ownerID                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ownerID_ckAsset             ASSET,
        CD_parent                      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_parkedAt                    TIMESTAMP QUERYABLE SORTABLE,
        CD_people                      BYTES QUERYABLE SORTABLE,
        CD_peopleConfidence            DOUBLE QUERYABLE SORTABLE,
        CD_peopleSourceRaw             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_peopleSourceRaw_ckAsset     ASSET,
        CD_people_ckAsset              ASSET,
        CD_place                       BYTES QUERYABLE SORTABLE,
        CD_placeRemindedAt             TIMESTAMP QUERYABLE SORTABLE,
        CD_placeSourceRaw              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_placeSourceRaw_ckAsset      ASSET,
        CD_processedAt                 TIMESTAMP QUERYABLE SORTABLE,
        CD_project                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_rawText                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_rawText_ckAsset             ASSET,
        CD_repeatRule                  BYTES QUERYABLE SORTABLE,
        CD_rulesAppliedAt              TIMESTAMP QUERYABLE SORTABLE,
        CD_showInCalendar              INT64 QUERYABLE SORTABLE,
        CD_sourceURL                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceURL_ckAsset           ASSET,
        CD_statusRaw                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_statusRaw_ckAsset           ASSET,
        CD_title                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_titleConfidence             DOUBLE QUERYABLE SORTABLE,
        CD_titleSourceRaw              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_titleSourceRaw_ckAsset      ASSET,
        CD_title_ckAsset               ASSET,
        CD_urgencyConfidence           DOUBLE QUERYABLE SORTABLE,
        CD_urgencyRaw                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_urgencyRaw_ckAsset          ASSET,
        CD_urgencySourceRaw            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_urgencySourceRaw_ckAsset    ASSET,
        "___createTime"                TIMESTAMP,
        "___createdBy"                 REFERENCE,
        "___etag"                      STRING,
        "___modTime"                   TIMESTAMP,
        "___modifiedBy"                REFERENCE,
        "___recordID"                  REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
