2026-10-21T07:27:07.2301050Z ##[group]Run # The window photos (.png) and the window size (.txt) MacGalleryTests attaches, under their names.
2026-10-21T07:27:07.2301800Z # The window photos (.png) and the window size (.txt) MacGalleryTests attaches, under their names.
2026-10-21T07:27:07.2302270Z # The gallery's bundle and the click test's (#544), each into its own folder.
2026-10-21T07:27:07.2302580Z mkdir -p MacGallery
2026-10-21T07:27:07.2302790Z for bundle in MacGallery MacDetailClick; do
2026-10-21T07:27:07.2303020Z   mkdir -p "raw-$bundle"
2026-10-21T07:27:07.2303380Z   [ -d "$bundle.xcresult" ] || [ "$bundle" = MacGallery ] || continue
2026-10-21T07:27:07.2303880Z   xcrun xcresulttool export attachments --path "$bundle.xcresult" --output-path "raw-$bundle" || true
2026-10-21T07:27:07.2304340Z done
2026-10-21T07:27:07.2304510Z python3 - <<'PY'
2026-10-21T07:27:07.2304740Z import json, pathlib, shutil
2026-10-21T07:27:07.2304970Z out = pathlib.Path("MacGallery")
2026-10-21T07:27:07.2305230Z for raw in sorted(pathlib.Path(".").glob("raw-*")):
2026-10-21T07:27:07.2305880Z     manifest = raw / "manifest.json"
2026-10-21T07:27:07.2306190Z     if not manifest.exists():
2026-10-21T07:27:07.2306390Z         continue
2026-10-21T07:27:07.2306600Z     for test in json.loads(manifest.read_text()):
2026-10-21T07:27:07.2306870Z         for a in test.get("attachments", []):
2026-10-21T07:27:07.2307150Z             name = a.get("suggestedHumanReadableName", "")
2026-10-21T07:27:07.2307430Z             if name.startswith("mac-gallery-"):
2026-10-21T07:27:07.2307690Z                 stem = name.split("_")[0]
2026-10-21T07:27:07.2308030Z                 suffix = pathlib.Path(a["exportedFileName"]).suffix
2026-10-21T07:27:07.2308490Z                 shutil.copy(raw / a["exportedFileName"], out / f"{stem}{suffix}")
2026-10-21T07:27:07.2308960Z print("\n".join(sorted(p.name for p in out.iterdir())) or "no Mac gallery attachments")
2026-10-21T07:27:07.2309290Z PY
2026-10-21T07:27:07.2345960Z shell: /bin/bash -e {0}
2026-10-21T07:27:07.2346150Z ##[endgroup]
