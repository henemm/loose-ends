2026-10-21T16:30:06.6243270Z ##[group]Run # The window photos (.png) and the window size (.txt) MacGalleryTests attaches, under their names.
2026-10-21T16:30:06.6243910Z # The window photos (.png) and the window size (.txt) MacGalleryTests attaches, under their names.
2026-10-21T16:30:06.6244400Z # The gallery's bundle and the click test's (#544), each into its own folder.
2026-10-21T16:30:06.6244730Z mkdir -p MacGallery
2026-10-21T16:30:06.6244980Z for bundle in MacGallery MacDetailClick MacKeyboard; do
2026-10-21T16:30:06.6245250Z   mkdir -p "raw-$bundle"
2026-10-21T16:30:06.6245520Z   [ -d "$bundle.xcresult" ] || [ "$bundle" = MacGallery ] || continue
2026-10-21T16:30:06.6245990Z   xcrun xcresulttool export attachments --path "$bundle.xcresult" --output-path "raw-$bundle" || true
2026-10-21T16:30:06.6246360Z done
2026-10-21T16:30:06.6246510Z python3 - <<'PY'
2026-10-21T16:30:06.6246720Z import json, pathlib, shutil
2026-10-21T16:30:06.6246940Z out = pathlib.Path("MacGallery")
2026-10-21T16:30:06.6247200Z for raw in sorted(pathlib.Path(".").glob("raw-*")):
2026-10-21T16:30:06.6247480Z     manifest = raw / "manifest.json"
2026-10-21T16:30:06.6247700Z     if not manifest.exists():
2026-10-21T16:30:06.6247890Z         continue
2026-10-21T16:30:06.6248100Z     for test in json.loads(manifest.read_text()):
2026-10-21T16:30:06.6248370Z         for a in test.get("attachments", []):
2026-10-21T16:30:06.6248650Z             name = a.get("suggestedHumanReadableName", "")
2026-10-21T16:30:06.6248930Z             if name.startswith("mac-gallery-"):
2026-10-21T16:30:06.6249190Z                 stem = name.split("_")[0]
2026-10-21T16:30:06.6249470Z                 suffix = pathlib.Path(a["exportedFileName"]).suffix
2026-10-21T16:30:06.6249850Z                 shutil.copy(raw / a["exportedFileName"], out / f"{stem}{suffix}")
2026-10-21T16:30:06.6250300Z print("\n".join(sorted(p.name for p in out.iterdir())) or "no Mac gallery attachments")
2026-10-21T16:30:06.6250800Z PY
2026-10-21T16:30:06.6616600Z shell: /bin/bash -e {0}
2026-10-21T16:30:06.6616790Z ##[endgroup]
