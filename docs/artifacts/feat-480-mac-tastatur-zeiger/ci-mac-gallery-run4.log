2026-10-21T08:41:45.4404510Z ##[group]Run # The window photos (.png) and the window size (.txt) MacGalleryTests attaches, under their names.
2026-10-21T08:41:45.4405080Z # The window photos (.png) and the window size (.txt) MacGalleryTests attaches, under their names.
2026-10-21T08:41:45.4405540Z # The gallery's bundle and the click test's (#544), each into its own folder.
2026-10-21T08:41:45.4405860Z mkdir -p MacGallery
2026-10-21T08:41:45.4406100Z for bundle in MacGallery MacDetailClick MacKeyboard; do
2026-10-21T08:41:45.4406370Z   mkdir -p "raw-$bundle"
2026-10-21T08:41:45.4406630Z   [ -d "$bundle.xcresult" ] || [ "$bundle" = MacGallery ] || continue
2026-10-21T08:41:45.4407090Z   xcrun xcresulttool export attachments --path "$bundle.xcresult" --output-path "raw-$bundle" || true
2026-10-21T08:41:45.4407460Z done
2026-10-21T08:41:45.4407600Z python3 - <<'PY'
2026-10-21T08:41:45.4407800Z import json, pathlib, shutil
2026-10-21T08:41:45.4408010Z out = pathlib.Path("MacGallery")
2026-10-21T08:41:45.4408260Z for raw in sorted(pathlib.Path(".").glob("raw-*")):
2026-10-21T08:41:45.4408530Z     manifest = raw / "manifest.json"
2026-10-21T08:41:45.4408740Z     if not manifest.exists():
2026-10-21T08:41:45.4408930Z         continue
2026-10-21T08:41:45.4409140Z     for test in json.loads(manifest.read_text()):
2026-10-21T08:41:45.4409410Z         for a in test.get("attachments", []):
2026-10-21T08:41:45.4409680Z             name = a.get("suggestedHumanReadableName", "")
2026-10-21T08:41:45.4409960Z             if name.startswith("mac-gallery-"):
2026-10-21T08:41:45.4410200Z                 stem = name.split("_")[0]
2026-10-21T08:41:45.4410480Z                 suffix = pathlib.Path(a["exportedFileName"]).suffix
2026-10-21T08:41:45.4410850Z                 shutil.copy(raw / a["exportedFileName"], out / f"{stem}{suffix}")
2026-10-21T08:41:45.4411280Z print("\n".join(sorted(p.name for p in out.iterdir())) or "no Mac gallery attachments")
2026-10-21T08:41:45.4411600Z PY
2026-10-21T08:41:45.4443440Z shell: /bin/bash -e {0}
2026-10-21T08:41:45.4443590Z ##[endgroup]
