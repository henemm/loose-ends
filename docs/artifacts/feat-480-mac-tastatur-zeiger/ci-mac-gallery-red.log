2026-10-21T05:20:57.9376310Z ##[group]Run # The window photos (.png) and the window size (.txt) MacGalleryTests attaches, under their names.
2026-10-21T05:20:57.9376890Z # The window photos (.png) and the window size (.txt) MacGalleryTests attaches, under their names.
2026-10-21T05:20:57.9377330Z # The gallery's bundle and the click test's (#544), each into its own folder.
2026-10-21T05:20:57.9377630Z mkdir -p MacGallery
2026-10-21T05:20:57.9377850Z for bundle in MacGallery MacDetailClick; do
2026-10-21T05:20:57.9378080Z   mkdir -p "raw-$bundle"
2026-10-21T05:20:57.9378340Z   [ -d "$bundle.xcresult" ] || [ "$bundle" = MacGallery ] || continue
2026-10-21T05:20:57.9386200Z   xcrun xcresulttool export attachments --path "$bundle.xcresult" --output-path "raw-$bundle" || true
2026-10-21T05:20:57.9386560Z done
2026-10-21T05:20:57.9386690Z python3 - <<'PY'
2026-10-21T05:20:57.9386880Z import json, pathlib, shutil
2026-10-21T05:20:57.9387080Z out = pathlib.Path("MacGallery")
2026-10-21T05:20:57.9387320Z for raw in sorted(pathlib.Path(".").glob("raw-*")):
2026-10-21T05:20:57.9387580Z     manifest = raw / "manifest.json"
2026-10-21T05:20:57.9387780Z     if not manifest.exists():
2026-10-21T05:20:57.9387960Z         continue
2026-10-21T05:20:57.9388160Z     for test in json.loads(manifest.read_text()):
2026-10-21T05:20:57.9388410Z         for a in test.get("attachments", []):
2026-10-21T05:20:57.9388670Z             name = a.get("suggestedHumanReadableName", "")
2026-10-21T05:20:57.9388940Z             if name.startswith("mac-gallery-"):
2026-10-21T05:20:57.9389180Z                 stem = name.split("_")[0]
2026-10-21T05:20:57.9389460Z                 suffix = pathlib.Path(a["exportedFileName"]).suffix
2026-10-21T05:20:57.9389810Z                 shutil.copy(raw / a["exportedFileName"], out / f"{stem}{suffix}")
2026-10-21T05:20:57.9390220Z print("\n".join(sorted(p.name for p in out.iterdir())) or "no Mac gallery attachments")
2026-10-21T05:20:57.9390520Z PY
2026-10-21T05:20:57.9637680Z shell: /bin/bash -e {0}
2026-10-21T05:20:57.9637870Z ##[endgroup]
