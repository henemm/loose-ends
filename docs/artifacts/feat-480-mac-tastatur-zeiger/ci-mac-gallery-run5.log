2026-10-21T14:42:50.6058400Z ##[group]Run # The window photos (.png) and the window size (.txt) MacGalleryTests attaches, under their names.
2026-10-21T14:42:50.6059730Z # The window photos (.png) and the window size (.txt) MacGalleryTests attaches, under their names.
2026-10-21T14:42:50.6060270Z # The gallery's bundle and the click test's (#544), each into its own folder.
2026-10-21T14:42:50.6060650Z mkdir -p MacGallery
2026-10-21T14:42:50.6060910Z for bundle in MacGallery MacDetailClick MacKeyboard; do
2026-10-21T14:42:50.6061190Z   mkdir -p "raw-$bundle"
2026-10-21T14:42:50.6061490Z   [ -d "$bundle.xcresult" ] || [ "$bundle" = MacGallery ] || continue
2026-10-21T14:42:50.6062180Z   xcrun xcresulttool export attachments --path "$bundle.xcresult" --output-path "raw-$bundle" || true
2026-10-21T14:42:50.6062650Z done
2026-10-21T14:42:50.6062840Z python3 - <<'PY'
2026-10-21T14:42:50.6063680Z import json, pathlib, shutil
2026-10-21T14:42:50.6063930Z out = pathlib.Path("MacGallery")
2026-10-21T14:42:50.6064220Z for raw in sorted(pathlib.Path(".").glob("raw-*")):
2026-10-21T14:42:50.6064510Z     manifest = raw / "manifest.json"
2026-10-21T14:42:50.6064750Z     if not manifest.exists():
2026-10-21T14:42:50.6064950Z         continue
2026-10-21T14:42:50.6065170Z     for test in json.loads(manifest.read_text()):
2026-10-21T14:42:50.6065460Z         for a in test.get("attachments", []):
2026-10-21T14:42:50.6065760Z             name = a.get("suggestedHumanReadableName", "")
2026-10-21T14:42:50.6066070Z             if name.startswith("mac-gallery-"):
2026-10-21T14:42:50.6066350Z                 stem = name.split("_")[0]
2026-10-21T14:42:50.6066650Z                 suffix = pathlib.Path(a["exportedFileName"]).suffix
2026-10-21T14:42:50.6067040Z                 shutil.copy(raw / a["exportedFileName"], out / f"{stem}{suffix}")
2026-10-21T14:42:50.6067500Z print("\n".join(sorted(p.name for p in out.iterdir())) or "no Mac gallery attachments")
2026-10-21T14:42:50.6068320Z PY
2026-10-21T14:42:50.6433270Z shell: /bin/bash -e {0}
2026-10-21T14:42:50.6433500Z ##[endgroup]
