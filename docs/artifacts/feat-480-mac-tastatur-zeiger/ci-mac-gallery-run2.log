2026-10-21T07:01:31.9037800Z ##[group]Run # The window photos (.png) and the window size (.txt) MacGalleryTests attaches, under their names.
2026-10-21T07:01:31.9038470Z # The window photos (.png) and the window size (.txt) MacGalleryTests attaches, under their names.
2026-10-21T07:01:31.9038960Z # The gallery's bundle and the click test's (#544), each into its own folder.
2026-10-21T07:01:31.9039290Z mkdir -p MacGallery
2026-10-21T07:01:31.9039520Z for bundle in MacGallery MacDetailClick; do
2026-10-21T07:01:31.9039840Z   mkdir -p "raw-$bundle"
2026-10-21T07:01:31.9040140Z   [ -d "$bundle.xcresult" ] || [ "$bundle" = MacGallery ] || continue
2026-10-21T07:01:31.9040620Z   xcrun xcresulttool export attachments --path "$bundle.xcresult" --output-path "raw-$bundle" || true
2026-10-21T07:01:31.9041140Z done
2026-10-21T07:01:31.9041360Z python3 - <<'PY'
2026-10-21T07:01:31.9041840Z import json, pathlib, shutil
2026-10-21T07:01:31.9042250Z out = pathlib.Path("MacGallery")
2026-10-21T07:01:31.9042630Z for raw in sorted(pathlib.Path(".").glob("raw-*")):
2026-10-21T07:01:31.9043040Z     manifest = raw / "manifest.json"
2026-10-21T07:01:31.9043320Z     if not manifest.exists():
2026-10-21T07:01:31.9043810Z         continue
2026-10-21T07:01:31.9044040Z     for test in json.loads(manifest.read_text()):
2026-10-21T07:01:31.9044380Z         for a in test.get("attachments", []):
2026-10-21T07:01:31.9044810Z             name = a.get("suggestedHumanReadableName", "")
2026-10-21T07:01:31.9045120Z             if name.startswith("mac-gallery-"):
2026-10-21T07:01:31.9045380Z                 stem = name.split("_")[0]
2026-10-21T07:01:31.9045730Z                 suffix = pathlib.Path(a["exportedFileName"]).suffix
2026-10-21T07:01:31.9046130Z                 shutil.copy(raw / a["exportedFileName"], out / f"{stem}{suffix}")
2026-10-21T07:01:31.9046600Z print("\n".join(sorted(p.name for p in out.iterdir())) or "no Mac gallery attachments")
2026-10-21T07:01:31.9053350Z PY
2026-10-21T07:01:31.9117330Z shell: /bin/bash -e {0}
2026-10-21T07:01:31.9117510Z ##[endgroup]
