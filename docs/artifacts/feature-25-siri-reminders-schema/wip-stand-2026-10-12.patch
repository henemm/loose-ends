diff --git a/Shared/Intents/ReminderSchema.swift b/Shared/Intents/ReminderSchema.swift
new file mode 100644
index 0000000..c8eefd7
--- /dev/null
+++ b/Shared/Intents/ReminderSchema.swift
@@ -0,0 +1,222 @@
+// Siri over Apple's reminders app schema, cut 1: createReminder (#25). The domain exists from
+// iOS/macOS 27 and not on watchOS. CI still builds with Xcode 26, where the schema types are missing,
+// so this is a compile-time guard, not `#available`. The switch goes away with #178 (CI on Xcode 27);
+// update, park instead of delete, createList, recurrence and Spotlight follow in #209.
+#if compiler(>=6.4) && !os(watchOS)
+import AppIntents
+import Foundation
+import GeoToolbox
+import SwiftData
+
+/// Turns what Siri delivers structured into a task, without a model and without interpretation.
+enum ReminderMapping {
+    /// Raw text is Siri's title plus the note on its own line; the title rule only reads Siri's title,
+    /// so a note never ends up in the title. An unknown list falls back to the inbox, nothing is created.
+    @MainActor
+    @discardableResult
+    static func capture(
+        title: String, note: String?, dueDate: DateComponents?, listID: String?, in context: ModelContext
+    ) throws -> TaskItem {
+        // A blank title is rejected even with a note: the title is what Siri heard as the task.
+        guard !title.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else { throw CaptureError.emptyText }
+        var rawText = title
+        if let note, !note.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
+            rawText += "\n" + note
+        }
+        return try CaptureService.save(
+            rawText, via: .siri, titleFrom: title,
+            due: dueDate.map { CaptureService.StructuredDue(components: $0, reason: "Siri") },
+            project: try project(for: listID, in: context), in: context
+        )
+    }
+
+    @MainActor
+    private static func project(for listID: String?, in context: ModelContext) throws -> Project? {
+        guard let listID, listID != ListEntity.inboxID, let id = UUID(uuidString: listID) else { return nil }
+        var descriptor = FetchDescriptor<Project>(predicate: #Predicate { $0.id == id })
+        descriptor.fetchLimit = 1
+        return try context.fetch(descriptor).first
+    }
+}
+
+@AppEnum(schema: .reminders.listType)
+enum ListKind: String, AppEnum {
+    case standard
+    static let caseDisplayRepresentations: [ListKind: DisplayRepresentation] = [.standard: "Standard"]
+}
+
+/// A list is a project (ADR-8); tasks without a project live in the virtual inbox "Loose Ends".
+@AppEntity(schema: .reminders.list)
+struct ListEntity: AppEntity {
+    static let inboxID = "inbox"
+    static var inbox: ListEntity { ListEntity(id: inboxID, name: "Loose Ends") }
+    static let defaultQuery = ListQuery()
+
+    let id: String
+    var name: String
+    var type: ListKind
+    var displayRepresentation: DisplayRepresentation { DisplayRepresentation(title: "\(name)") }
+
+    init(id: String, name: String) {
+        self.id = id
+        self.name = name
+        self.type = .standard
+    }
+
+    init(project: Project) {
+        self.init(id: project.id.uuidString, name: project.name)
+    }
+
+    /// The inbox and any project by id, archived ones included; unknown ids are left out.
+    @MainActor
+    static func entities(for ids: [String], in context: ModelContext) throws -> [ListEntity] {
+        let projectIDs = ids.compactMap(UUID.init(uuidString:))
+        let projects = try context.fetch(FetchDescriptor<Project>(predicate: #Predicate { projectIDs.contains($0.id) }))
+        let byID = Dictionary(projects.map { ($0.id.uuidString, ListEntity(project: $0)) }, uniquingKeysWith: { first, _ in first })
+        return ids.compactMap { $0 == inboxID ? inbox : byID[$0] }
+    }
+
+    /// The inbox first, then the projects that are not archived, by sort order.
+    @MainActor
+    static func suggested(in context: ModelContext) throws -> [ListEntity] {
+        let descriptor = FetchDescriptor<Project>(
+            predicate: #Predicate { $0.archivedAt == nil }, sortBy: [SortDescriptor(\.sortOrder)]
+        )
+        return [inbox] + (try context.fetch(descriptor)).map(ListEntity.init(project:))
+    }
+
+    /// A string query lets Siri resolve a spoken list name ("in Garten").
+    struct ListQuery: EntityStringQuery {
+        func entities(matching string: String) async throws -> [ListEntity] {
+            try await suggestedEntities().filter { $0.name.localizedCaseInsensitiveContains(string) }
+        }
+
+        func entities(for identifiers: [String]) async throws -> [ListEntity] {
+            try await MainActor.run {
+                let container = try ModelContainerFactory.make()
+                return try ListEntity.entities(for: identifiers, in: ModelContext(container))
+            }
+        }
+
+        func suggestedEntities() async throws -> [ListEntity] {
+            try await MainActor.run {
+                let container = try ModelContainerFactory.make()
+                return try ListEntity.suggested(in: ModelContext(container))
+            }
+        }
+    }
+}
+
+/// Read-only view of a task for Siri. Writes go through `CaptureService.save` only.
+@AppEntity(schema: .reminders.reminder)
+struct ReminderEntity: AppEntity {
+    static let defaultQuery = ReminderQuery()
+
+    let id: UUID
+    var title: String
+    var list: ListEntity
+    var isCompleted: Bool
+    var creationDate: Date?
+    var dueDate: DateComponents?
+    // Required by the schema, not mapped in cut 1 (#209): always empty.
+    var note: AttributedString?
+    var tags: Set<String>
+    var urls: [URL]
+    var recurrence: Calendar.RecurrenceRule?
+    var isFlagged: Bool?
+    var completionDate: Date?
+    var locationTrigger: LocationTriggerEntity?
+    var displayRepresentation: DisplayRepresentation { DisplayRepresentation(title: "\(title)") }
+
+    init(task: TaskItem) {
+        self.id = task.id
+        self.title = task.displayTitle
+        self.list = task.project.map(ListEntity.init(project:)) ?? .inbox
+        self.isCompleted = task.status == .done
+        self.creationDate = task.capturedAt
+        let parts: Set<Calendar.Component> = task.dueHasTime ? [.year, .month, .day, .hour, .minute] : [.year, .month, .day]
+        self.dueDate = task.dueDate.map { Calendar.current.dateComponents(parts, from: $0) }
+        self.tags = []
+        self.urls = []
+    }
+
+    /// Tasks by id in every status; unknown ids are left out.
+    @MainActor
+    static func entities(for ids: [UUID], in context: ModelContext) throws -> [ReminderEntity] {
+        let tasks = try context.fetch(FetchDescriptor<TaskItem>(predicate: #Predicate { ids.contains($0.id) }))
+        return tasks.map(ReminderEntity.init(task:))
+    }
+
+    struct ReminderQuery: EntityQuery {
+        func entities(for identifiers: [UUID]) async throws -> [ReminderEntity] {
+            try await MainActor.run {
+                let container = try ModelContainerFactory.make()
+                return try ReminderEntity.entities(for: identifiers, in: ModelContext(container))
+            }
+        }
+    }
+}
+
+// The schema requires the next two types for createReminder. Loose Ends has neither location triggers nor
+// sections, so their queries resolve nothing and Siri's values are not mapped (#209).
+@AppEnum(schema: .reminders.locationTriggerEvent)
+enum LocationTriggerEvent: String, AppEnum {
+    case arrive, depart
+    static let caseDisplayRepresentations: [LocationTriggerEvent: DisplayRepresentation] = [
+        .arrive: "Arrive", .depart: "Depart",
+    ]
+}
+
+@AppEntity(schema: .reminders.locationTrigger)
+struct LocationTriggerEntity: AppEntity {
+    static let defaultQuery = LocationTriggerQuery()
+    let id: String
+    var place: PlaceDescriptor
+    var event: LocationTriggerEvent
+    var displayRepresentation: DisplayRepresentation { DisplayRepresentation(title: "\(id)") }
+
+    struct LocationTriggerQuery: EntityStringQuery {
+        func entities(for identifiers: [String]) async throws -> [LocationTriggerEntity] { [] }
+        func entities(matching string: String) async throws -> [LocationTriggerEntity] { [] }
+    }
+}
+
+@AppEntity(schema: .reminders.section)
+struct SectionEntity: AppEntity {
+    static let defaultQuery = SectionQuery()
+    let id: String
+    var name: String
+    var list: ListEntity
+    var displayRepresentation: DisplayRepresentation { DisplayRepresentation(title: "\(name)") }
+
+    struct SectionQuery: EntityStringQuery {
+        func entities(for identifiers: [String]) async throws -> [SectionEntity] { [] }
+        func entities(matching string: String) async throws -> [SectionEntity] { [] }
+    }
+}
+
+@AppIntent(schema: .reminders.createReminder)
+struct CreateReminderIntent: AppIntent {
+    var title: String
+    var list: ListEntity?
+    var note: AttributedString?
+    var dueDate: DateComponents?
+    var isFlagged: Bool?
+    var images: [IntentFile]
+    var tags: Set<String>
+    var urls: [URL]
+    var recurrence: Calendar.RecurrenceRule?
+    var locationTrigger: LocationTriggerEntity?
+    var section: SectionEntity?
+
+    @MainActor
+    func perform() async throws -> some IntentResult & ReturnsValue<ReminderEntity> {
+        let container = try ModelContainerFactory.make()
+        let task = try ReminderMapping.capture(
+            title: title, note: note.map { String($0.characters) }, dueDate: dueDate,
+            listID: list?.id, in: ModelContext(container)
+        )
+        return .result(value: ReminderEntity(task: task))
+    }
+}
+#endif
diff --git a/Shared/Services/CaptureService.swift b/Shared/Services/CaptureService.swift
index 400ab0d..400a2cd 100644
--- a/Shared/Services/CaptureService.swift
+++ b/Shared/Services/CaptureService.swift
@@ -8,11 +8,22 @@ enum CaptureError: Error, Equatable {
 /// The one write path for new tasks. Every channel (app, Siri, Watch, Control Center, Share) goes
 /// through here so the rules live in one place: the text is trimmed once and never touched again (ADR-3).
 enum CaptureService {
+    /// A due date a channel already delivers structured (Siri's reminders schema, #25), with the
+    /// reason its revision carries. Without year, month and day it sets nothing.
+    struct StructuredDue {
+        let components: DateComponents
+        let reason: String
+    }
+
+    /// `titleFrom` is the text the title rule reads; without it, the whole raw text (#202).
     @discardableResult
     static func save(
         _ rawText: String,
         via channel: CaptureChannel,
         sourceURL: URL? = nil,
+        titleFrom: String? = nil,
+        due: StructuredDue? = nil,
+        project: Project? = nil,
         in context: ModelContext
     ) throws -> TaskItem {
         let text = rawText.trimmingCharacters(in: .whitespacesAndNewlines)
@@ -20,9 +31,33 @@ enum CaptureService {
         let item = TaskItem(rawText: text, capturedVia: channel, sourceURL: sourceURL)
         // A title from the moment of capture, by rule: no AI marker, no revision (#202). Without the
         // words the rule step reads into due date, importance and urgency (#217).
-        item.title = TitleRule.title(from: text, reference: item.capturedAt)
+        item.title = TitleRule.title(from: titleFrom ?? text, reference: item.capturedAt)
         context.insert(item)
+        item.project = project
+        if let due { apply(due, to: item) }
         try context.save()
         return item
     }
+
+    /// Same pattern as the due-date rule step: AI source, confidence 1.0 (nothing was guessed), one
+    /// revision. `hour` decides whether the date has a time; a missing minute counts as 0.
+    private static func apply(_ due: StructuredDue, to item: TaskItem) {
+        let parts = due.components
+        guard let year = parts.year, let month = parts.month, let day = parts.day else { return }
+        let hasTime = parts.hour != nil
+        let exact = DateComponents(
+            year: year, month: month, day: day,
+            hour: parts.hour ?? 0, minute: hasTime ? parts.minute ?? 0 : 0
+        )
+        guard let date = Calendar.current.date(from: exact) else { return }
+        let revision = Revision(
+            task: item, field: .dueDate, oldValue: nil, newValue: date.ISO8601Format(),
+            author: .ai, reason: due.reason
+        )
+        item.revisions = (item.revisions ?? []) + [revision]
+        item.dueDate = date
+        item.dueHasTime = hasTime
+        item.dueSourceRaw = FieldSource.ai.rawValue
+        item.dueConfidence = 1.0
+    }
 }
