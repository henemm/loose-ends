2026-10-22T12:44:46.0244960Z ##[group]Run # The window photos (.png) and the window size (.txt) MacGalleryTests attaches, under their names.
2026-10-22T12:44:46.0245880Z # The window photos (.png) and the window size (.txt) MacGalleryTests attaches, under their names.
2026-10-22T12:44:46.0246360Z # The gallery's bundle and the click test's (#544), each into its own folder.
2026-10-22T12:44:46.0246680Z mkdir -p MacGallery
2026-10-22T12:44:46.0246930Z for bundle in MacGallery MacDetailClick MacKeyboard; do
2026-10-22T12:44:46.0247240Z   mkdir -p "raw-$bundle"
2026-10-22T12:44:46.0247590Z   [ -d "$bundle.xcresult" ] || [ "$bundle" = MacGallery ] || continue
2026-10-22T12:44:46.0248090Z   xcrun xcresulttool export attachments --path "$bundle.xcresult" --output-path "raw-$bundle" || true
2026-10-22T12:44:46.0248480Z done
2026-10-22T12:44:46.0248670Z python3 - <<'PY'
2026-10-22T12:44:46.0248930Z import json, pathlib, shutil
2026-10-22T12:44:46.0249180Z out = pathlib.Path("MacGallery")
2026-10-22T12:44:46.0249500Z for raw in sorted(pathlib.Path(".").glob("raw-*")):
2026-10-22T12:44:46.0249780Z     manifest = raw / "manifest.json"
2026-10-22T12:44:46.0250040Z     if not manifest.exists():
2026-10-22T12:44:46.0250290Z         continue
2026-10-22T12:44:46.0250510Z     for test in json.loads(manifest.read_text()):
2026-10-22T12:44:46.0250790Z         for a in test.get("attachments", []):
2026-10-22T12:44:46.0251280Z             name = a.get("suggestedHumanReadableName", "")
2026-10-22T12:44:46.0251590Z             if name.startswith("mac-gallery-"):
2026-10-22T12:44:46.0251910Z                 stem = name.split("_")[0]
2026-10-22T12:44:46.0252270Z                 suffix = pathlib.Path(a["exportedFileName"]).suffix
2026-10-22T12:44:46.0252710Z                 shutil.copy(raw / a["exportedFileName"], out / f"{stem}{suffix}")
